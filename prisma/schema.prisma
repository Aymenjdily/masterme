generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  skills        String[]  @default([])
  /// When the tech radar was last fetched for this user (daily job or Refresh)
  newsFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  portfolioLinks    PortfolioLink[]
  socialApps        SocialApp[]
  learningPaths     LearningPath[]
  timelines         Timeline[]
  jobOffers         JobOffer[]
  jobApplications   JobApplication[]
  recruiterContacts RecruiterContact[]
  projects          Project[]
  techNews          TechNews[]
  jobRadarConfig    JobRadarConfig?
  jobRadarSearches  JobSearch[]
  dailyUsages       DailyUsage[]
  collectionRuns    CollectionRun[]
  jobNotifications  JobNotification[]
  monthlyCosts      MonthlyCost[]
  aiEvents          AiEvent[]
  infraCosts        InfraCostSnapshot[]
  neonAccountCosts  NeonAccountSnapshot[]
  projectLogs       ProjectLog[]
  notes             Note[]
  /// When the user last opened /logs (drives the unseen-errors badge)
  logsSeenAt        DateTime?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model PortfolioLink {
  id        String   @id @default(cuid())
  userId    String
  title     String
  url       String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialApp {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  username  String
  url       String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       LearningItem[]
}

model LearningItem {
  id             String       @id @default(cuid())
  learningPathId String
  title          String
  description    String?
  resourceUrl    String?
  status         String       @default("not_started")
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
}

model Timeline {
  id         String      @id @default(cuid())
  userId     String
  date       DateTime
  wakeUpHour Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks     TimeBlock[]

  @@unique([userId, date])
}

model TimeBlock {
  id          String   @id @default(cuid())
  timelineId  String
  hour        Int
  title       String
  description String?
  status      String   @default("planned")
  priority    String   @default("medium")
  /// The #todo note this block was made from (kept as a plain block if the note is deleted)
  noteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@unique([timelineId, hour])
  @@index([noteId])
}

model JobOffer {
  id             String           @id @default(cuid())
  userId         String
  title          String
  company        String
  location       String?
  source         String
  url            String
  description    String?
  salary         String?
  postedDate     DateTime?
  scrapedDate    DateTime         @default(now())
  status         String           @default("new")
  recruiterName  String?
  recruiterEmail String?
  recruiterPhone String?
  /// JobRadar: stable LinkedIn job id (normalizing this covers dedupe across searches)
  externalId     String?
  /// JobRadar: target market the search came from: morocco | france
  country        String?
  /// remote | hybrid | onsite | unknown
  workplaceType  String?
  /// e.g. Full-time, Contract (as LinkedIn reports it)
  employmentType String?
  /// Tech keywords extracted from the description
  technologies   String[]         @default([])
  technologiesMatched String[]    @default([])
  technologiesMissing String[]    @default([])
  matchScore     Int?
  matchReasons   String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   JobApplication[]
  notifications  JobNotification[]

  @@unique([userId, url])
  @@unique([userId, externalId])
  @@index([userId, status])
  @@index([userId, country])
}

model JobApplication {
  id              String    @id @default(cuid())
  userId          String
  jobOfferId      String
  applicationDate DateTime
  coverLetter     String?
  resumeVersion   String?
  status          String?
  followUpNotes   String?
  lastFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer        JobOffer  @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
}

model RecruiterContact {
  id              String    @id @default(cuid())
  userId          String
  name            String
  email           String?
  phone           String?
  company         String?
  linkedinUrl     String?
  notes           String?
  lastContactedAt DateTime?
  /// Set when the conversation is ended; reminders stop while it's set
  endedAt         DateTime?
  /// offer | application | passed | not_interested | no_reply | other
  endReason       String?
  endNote         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                String              @id @default(cuid())
  userId            String
  title             String
  description       String?
  type              String
  status            String              @default("active")
  clientName        String?
  url               String?
  previewImageUrl   String?
  neonProjectId     String?
  vercelHosting     Boolean             @default(false)
  vercelProjectId   String?
  vercelProjectName String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  billings          ProjectBilling[]
  monthlyCosts      MonthlyCost[]
  infraCosts        InfraCostSnapshot[]
  logs              ProjectLog[]
}

model ProjectBilling {
  id          String    @id @default(cuid())
  projectId   String
  billingType String
  amount      Float
  currency    String    @default("MAD")
  description String?
  invoiceDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TechNews {
  id            String    @id @default(cuid())
  userId        String
  title         String
  url           String
  source        String
  description   String?
  publishedDate DateTime?
  tags          String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
}

model MonthlyCost {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  name      String
  category  String   @default("app")
  amount    Float
  currency  String   @default("MAD")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

/// One row per AI call (decision or generation). Feeds the observability panel.
model AiEvent {
  id           String   @id @default(cuid())
  userId       String
  feature      String
  kind         String // decision | generation
  provider     String // openai | jev
  model        String
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  confidence   Float?
  outcome      String   @default("suggested") // applied | suggested | accepted | edited | rejected | failed
  summary      Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, feature])
}

/// One infra cost reading per project per day (Neon usage estimate, month to date). Recalculating the same day replaces it.
model InfraCostSnapshot {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  /// The Neon project this reading came from; relinking starts a new series.
  neonProjectId String
  day           DateTime @db.Date
  neonUsd       Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, day])
  @@index([userId, day])
}

/// Whole Neon account cost for the billing period so far (all projects), one row per user per day.
model NeonAccountSnapshot {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime @db.Date
  periodStart  DateTime
  totalUsd     Float
  computeUsd   Float
  storageUsd   Float
  projectCount Int
  /// Every Neon project this period: [{ id, name, totalUsd }]
  projects     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// Errors, warnings and builds from a project's Vercel deployment (see lib/project-logs.ts).
/// The same line on the same day is grouped into one row with a count.
model ProjectLog {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  level         String // error | warn | build
  fingerprint   String
  method        String?
  path          String?
  status        Int?
  message       String
  source        String?
  domain        String?
  deploymentId  String?
  count         Int      @default(1)
  firstAt       DateTime
  lastAt        DateTime
  buildState    String?
  commitMessage String?
  commitSha     String?
  branch        String?
  durationS     Int?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fingerprint])
  @@index([userId, lastAt])
}

model Note {
  id         String      @id @default(cuid())
  userId     String
  title      String      @default("")
  body       String      @default("") @db.Text
  tags       String[]    @default([])
  pinned     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeBlocks TimeBlock[]

  @@index([userId, pinned, updatedAt])
}

/// JobRadar: per-user collection profile, quotas, budget and notification prefs.
/// Single-user app — one row per user, created on first collect run.
model JobRadarConfig {
  id               String  @id @default(cuid())
  userId           String  @unique
  /// Timezone used for daily quota day boundaries (e.g. "Africa/Casablanca")
  timezone         String  @default("Africa/Casablanca")
  dailyQuotaMorocco Int    @default(50)
  dailyQuotaFrance  Int    @default(50)
  dailyQuotaSaudi   Int    @default(50)
  dailyQuotaUk      Int    @default(50)
  /// Apify monthly budget cap in USD
  monthlyBudgetUsd Float   @default(5)
  /// Percentage of the budget held back as a safety margin
  budgetMarginPct  Int     @default(10)
  // Matching profile (JobRadar §2). Skills stay on User.skills.
  profileTitle     String   @default("Full-Stack Engineer")
  yearsExperience  Int      @default(4)
  employmentTypes  String[] @default(["full-time", "contract", "freelance"])
  titleKeywords    String[] @default(["full stack", "frontend", "software engineer", "react", "node"])
  /// Overrides for the default matcher weights: { title, skills, experience, location, remote, employment, recency }
  matchWeights     Json     @default("{}")
  /// Notifications go to new jobs scoring at least this (0 = disabled)
  matchThreshold   Int      @default(70)
  /// When false, collection skips everything except application tracking
  collectEnabled   Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  searches         JobSearch[]

  @@map("job_radar_config")
}

/// One search = one keyword + location pair for a target market.
model JobSearch {
  id             String  @id @default(cuid())
  userId         String
  configId       String
  /// morocco | france
  country        String
  keyword        String
  /// Location text as typed into LinkedIn (country or city)
  location       String
  /// Cap for this single search, applied at the actor level too
  limitPerSource Int     @default(25)
  enabled        Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  config         JobRadarConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([configId, enabled, country])
}

/// One execution of the collector: totals, Apify run id, cost, errors.
model CollectionRun {
  id               String    @id @default(cuid())
  userId           String
  /// running | skipped | success | failed
  status           String    @default("running")
  /// cron | manual
  trigger          String    @default("cron")
  apifyRunIds      String[]  @default([])
  resultsRetrieved Int       @default(0)
  newJobs          Int       @default(0)
  /// Actual USD cost reported by Apify for this run; null = unknown
  apifyUsd         Float?
  /// Why the run was skipped or failed (budget/quota/overlap/error detail)
  note             String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Per country per day quota accounting (day in the config timezone).
model DailyUsage {
  id               String   @id @default(cuid())
  userId           String
  /// morocco | france
  country          String
  day              DateTime @db.Date
  resultsRetrieved Int      @default(0)
  newJobs          Int      @default(0)
  runs             Int      @default(0)
  apifyUsd         Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, country, day])
}

/// JobRadar: notification dedup/history (one per user+job+channel).
model JobNotification {
  id       String   @id @default(cuid())
  userId   String
  jobId    String
  /// email | telegram
  channel  String
  /// sent | failed | skipped
  status   String
  error    String?
  sentAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job      JobOffer @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, channel])
}
